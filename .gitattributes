# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force bash scripts and git hooks to always have LF line endings
scripts/verify.sh text eol=lf
scripts/*.sh text eol=lf
tools/*.sh text eol=lf
.githooks/* text eol=lf

# Binary files
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.sqlite binary
*.db binary
