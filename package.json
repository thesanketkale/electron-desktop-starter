{
  "name": "electron-foundation",
  "version": "0.1.0",
  "description": "Security-first Electron + TypeScript desktop foundation with typed IPC, local SQLite storage, auto-update from GitHub Releases and a signed Windows/macOS release pipeline.",
  "main": "./out/main/index.js",
  "author": "Sanket Kale",
  "license": "MIT",
  "homepage": "https://github.com/thesanketkale/electron-foundation#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thesanketkale/electron-foundation.git"
  },
  "keywords": [
    "electron",
    "typescript",
    "desktop-app",
    "sqlite",
    "auto-update",
    "code-signing",
    "notarization",
    "github-actions",
    "vite",
    "playwright"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "electron-vite build && electron-builder --dir --publish never && node scripts/apply-fuses.mjs",
    "package:dist": "electron-vite build && electron-builder --publish never && node scripts/apply-fuses.mjs",
    "fuses:apply": "node scripts/apply-fuses.mjs",
    "fuses:verify": "node scripts/verify-fuses.mjs",
    "mock-updater": "node scripts/mock-update-server.mjs"
  },
  "dependencies": {
    "@electron/fuses": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
